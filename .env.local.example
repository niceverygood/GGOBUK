# AI
# OpenRouter is preferred when set. Anthropic is kept as a fallback.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL_MAIN=anthropic/claude-opus-4.7
OPENROUTER_MODEL_SAJU=openai/gpt-5.1
OPENROUTER_MODEL_COMPAT=openai/gpt-5.1
OPENROUTER_MODEL_CHEAP=anthropic/claude-haiku-4.5
OPENROUTER_APP_NAME=GGOBUK
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI image generation
# Server-only. Used for "부적 받기" image generation.
OPENAI_API_KEY=sk-proj-...
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_FORMAT=png
OPENAI_COMIC_IMAGE_MODEL=gpt-image-2
OPENAI_COMIC_IMAGE_SIZE=1024x1536
OPENAI_COMIC_IMAGE_FORMAT=png
SUPABASE_COMIC_BUCKET=generated-comics

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# New name (Supabase 2025+). Older projects may still use NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=

# Beta free mode — 출시 전 단계에서 모든 크레딧 차감(spendCredits) skip.
# true 설정 시 사용자가 잔액 0이어도 모든 풀이/궁합/부적/웹툰 무료 사용 가능.
# 잔액 표시·"N꼬북알" 라벨은 그대로 노출되되 결제만 안 됨.
# 출시 시 이 라인 삭제 또는 false 로 변경 후 Redeploy.
BETA_FREE_MODE=true

# Web Push (VAPID) — 매일 운세 푸시 알림.
# 키 생성: node -e "console.log(require('web-push').generateVAPIDKeys())"
# 또는: npx web-push generate-vapid-keys
# public 키는 클라이언트 구독용이라 NEXT_PUBLIC_ 으로도 동일 값 노출 (안전).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@bottlecorp.kr

# Kakao OAuth
KAKAO_REST_API_KEY=
KAKAO_ADMIN_KEY=

# Kakao Pay — CID configuration
# Test (sandbox):  TC0ONETIME / TC0SUBSCRIPTION (default when env vars empty)
# Production:      Apply at https://developers.kakao.com → 결제 → 가맹점 등록
KAKAO_PAY_CID=TC0ONETIME
# Override for one-time payments if different from KAKAO_PAY_CID.
KAKAO_PAY_CID_ONETIME=
# Override for subscription payments (v2, currently inactive).
KAKAO_PAY_CID_SUBSCRIPTION=
# Webhook HMAC secret — required in production for signature verification.
KAKAO_PAY_SECRET_KEY=

# Kakao channel chatbot (카카오 i 오픈빌더 스킬 서버)
# Skill server endpoint: POST /api/kakao/skill
# Shared secret that protects the skill endpoint. Set it here AND in the 오픈빌더
# skill's request URL — as a query (?secret=...) or header (X-Skill-Secret).
# If empty, the endpoint accepts all requests (setup only — set this before launch).
KAKAO_SKILL_SECRET=
# Daily per-user message cap for cost control (default 30).
KAKAO_DAILY_MSG_LIMIT=30

# FCM
FCM_SERVER_KEY=
NEXT_PUBLIC_FCM_VAPID_KEY=

# App
# Local development: http://localhost:3000
# Vercel production: https://ggobuk.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=

# Admin (관리자 대시보드 /admin 접근 허용)
# 둘 다 콤마로 여러 개 가능. users.is_admin=true 로도 부여 가능.
ADMIN_USER_IDS=
ADMIN_EMAILS=

# Cron — Vercel Cron sends this as `Authorization: Bearer <secret>`.
CRON_SECRET=

# Monitoring (optional — logger.ts auto-connects when set)
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
